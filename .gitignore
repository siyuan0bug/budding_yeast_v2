*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# 2. Datasets, weights, and binary artifacts
*.npz
*.npy
*.csv
*.zip
*.tar
*.tar.gz
*.ckpt
*.pt
*.pth
*.pkl
*.h5
*.parquet
*.feather

# 3. Logs and runtime output directories (anchored to root)
*.log
/logs/
/logs_v3/
/lightning_logs/
/train_result/
/eval_result/
/eval_results*/
/tune_results/
/swanlog/
/wandb/
/model_visualizations/

# 4. Experimental checkpoints, archives & scratch
/experiments
/experiments/
/archive/
/scratch/


# 5. Toolchains & test suites policy
tests/
/scripts/analysis/
# Note: scripts/launch/ and scripts/eval/ are retained and tracked

/analysis/

# 6. Transient docs & root drafts
/docs/*_2026-*.md
/参考实施方案
/tmp*
/*.tmp

# 7. OS & IDE artifacts
.DS_Store
.vscode/
.idea/
*.swp
*~
