# ====================================================================
# Budding Yeast Neural Operator Project .gitignore
# ====================================================================

# 1. Byte-compiled / optimized / cache files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# 2. Datasets, weights, and binary artifacts
*.npz
*.npy
*.csv
*.zip
*.tar
*.tar.gz
*.ckpt
*.pt
*.pth
*.pkl
*.h5

# 3. Logs and runtime output directories
*.log
logs/
logs_v3/
lightning_logs/
train_result/
eval_result/
eval_results*/
tune_results/
swanlog/
wandb/
model_visualizations/

# 4. Experimental checkpoints & big directories
experiments/
archive/
!/utils/archive/
/utils/archive/*
!/utils/archive/*.py
!/utils/archive/README.md
!/scripts/analysis/archive/
/scripts/analysis/archive/*
!/scripts/analysis/archive/*.py
!/scripts/analysis/archive/README.md
scratch/
tests/

# 5. OS & IDE artifacts
.DS_Store
.vscode/
.idea/
*.swp
*~
